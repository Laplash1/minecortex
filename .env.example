# Local Paper 1.21.4 / one offline bot / Node >=22 (tested with Node 24)
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
MINECRAFT_VERSION=1.21.4
MINECRAFT_AUTH=offline
MULTIPLE_PLAYERS_COUNT=1
PLAYER1_USERNAME=MineCortexBot1
AUTO_RESPAWN=false

# true: logs -> workbench -> wooden pickaxe -> cobblestone, then wait.
# false: initialize and wait for !start or !goto x y z.
AI_AUTOSTART=true
PERFORMANCE_MONITORING=false
DEBUG_MODE=false

# Leave unset/empty. OpenAI integration is outside the local acceptance scope.
OPENAI_API_KEY=
